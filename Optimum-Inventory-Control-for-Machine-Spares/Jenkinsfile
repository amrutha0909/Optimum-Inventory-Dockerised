pipeline {
    agent any

    triggers {
        githubPush()
    }

    environment {
        COMPOSE_PROJECT_NAME = 'inventory_optimum'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                echo 'Running Tests...'
                echo 'Tests passed! (Placeholder)'
            }
        }

        stage('Deploy') {
            steps {
                dir('Optimum-Inventory-Control-for-Machine-Spares') {
                    sh '''
                    docker compose down --remove-orphans || true
                    docker ps -q --filter "publish=3000" | xargs -r docker stop
                    docker ps -q --filter "publish=5000" | xargs -r docker stop
                    docker ps -q --filter "publish=3000" | xargs -r docker rm
                    docker ps -q --filter "publish=5000" | xargs -r docker rm

                    docker compose up -d --build
                    '''
                }
            }
        }

        stage('Cleanup') {
            steps {
                echo 'Cleaning up unused Docker resources...'
                sh 'docker image prune -f'
            }
        }
    }

    post {
        success {
            echo 'Pipeline executed successfully! Application is running.'
        }

        failure {
            echo 'Pipeline failed. Check logs for details.'
        }
    }
}